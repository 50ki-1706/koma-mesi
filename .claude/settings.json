{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "devbox",
            "args": [
              "run",
              "--",
              "node",
              "${CLAUDE_PROJECT_DIR}/.codex/hooks/require-devbox.mjs"
            ],
            "timeout": 30,
            "statusMessage": "Checking Devbox command policy"
          }
        ]
      }
    ]
  }
}
