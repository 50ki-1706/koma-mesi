# Database
# Local development automatically uses `file:local.db`, so you do NOT need to set
# the Turso variables below in this file. They are configured in the Vercel dashboard
# for production and preview deployments instead.
# PRODUCTION_TURSO_DATABASE_URL=
# PRODUCTION_TURSO_AUTH_TOKEN=
# PREVIEW_TURSO_DATABASE_URL=
# PREVIEW_TURSO_AUTH_TOKEN=

# Better Auth
BETTER_AUTH_SECRET= # openssl rand -hex 32 で生成
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
# Google Cloud Console → APIs & Services → Credentials から取得
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps
# Google Cloud Console → APIs & Services → Credentials から取得
# ブラウザに露出するキーのため、キーの制限で HTTP リファラー（許可するWebサイト）を設定すること
# API制限で Maps JavaScript API と Directions API (Legacy) を有効化し、これらのみに絞ること
# 上記APIの利用には課金設定（請求先アカウントの有効化）が必要
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
