# Database
DATABASE_URL="file:local.db"

# Better Auth
BETTER_AUTH_SECRET= # openssl rand -hex 32 で生成
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
# Google Cloud Console → APIs & Services → Credentials から取得
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps
# Google Cloud Console → APIs & Services → Credentials から取得
# ブラウザに露出するキーのため、キーの制限で HTTP リファラー（許可するWebサイト）を設定すること
# API制限で Maps JavaScript API と Directions API (Legacy) を有効化し、これらのみに絞ること
# 上記APIの利用には課金設定（請求先アカウントの有効化）が必要
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# サーバーからPlaces API (New)を呼び出すためのキー
# API制限でPlaces API (New)のみに絞り、クライアントへ公開しないこと
GOOGLE_MAPS_API_KEY=

# Vercel Cronからの日次推薦生成リクエストを検証する16文字以上のランダム値
CRON_SECRET=
